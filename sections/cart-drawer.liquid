<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

<cart-drawer>
  <div class="cart-drawer-wrapper">
    <div class="cart-drawer-modal">
      <div class="cart-modal__header">
        <h3 class="cart-modal__header-title">Your Cart</h3>
        <div class="cart-modal__header-right">
          <button id="cart-modal__close-btn">
            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="16" height="16" viewBox="0 0 50 50">
              <path d="M 7.71875 6.28125 L 6.28125 7.71875 L 23.5625 25 L 6.28125 42.28125 L 7.71875 43.71875 L 25 26.4375 L 42.28125 43.71875 L 43.71875 42.28125 L 26.4375 25 L 43.71875 7.71875 L 42.28125 6.28125 L 25 23.5625 Z"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="cart-modal__body">
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}

            <div class="cart-item" data-line="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-item__media">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 240 }}"
                    alt="{{ item.title | escape }}"
                    width="100"
                    height="130"
                    loading="lazy"
                  >
                {% endif %}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant or item.variant.title == 'Default Title' -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div class="cart-item__qty">
                  <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                  <input type="number" min="0" value="{{ item.quantity }}" data-qty-input aria-label="Quantity">
                  <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
              </div>
              <div class="cart-item__aside">
                <span class="cart-item__price">{{ item.final_line_price | money }}</span>
                <button type="button" class="cart-item__remove" data-remove aria-label="Remove {{ item.title | escape }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18"></path>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                    <path d="M10 11v6"></path>
                    <path d="M14 11v6"></path>
                  </svg>
                </button>
              </div>
            </div>

          {% endfor %}
        {% else %}
          <p>Your cart is empty.</p>
        {% endif %}
      </div>
      <div class="cart-modal__footer" data-item-count="{{ cart.item_count }}">
        {% if cart.item_count > 0 %}
          <div class="clear-cart-btn-wrapper">
            <button type="button" class="clear-cart-btn">Clear cart</button>
          </div>
        {% endif %}
        <div class="subtotal-wrapper">
          <p class="subtotal-txt">
            Subtotal: <span class="subtotal-price">{{ cart.total_price | money }}</span>
          </p>
        </div>
        <a class="view-cart-btn" href="{{ routes.cart_url }}">View cart</a>
        <a class="checkout-btn" href="/checkout">Checkout</a>
      </div>
    </div>
  </div>
</cart-drawer>

{% stylesheet %}
  cart-drawer {
    .cart-drawer-wrapper {
      background: #00000080;
      bottom: 0;
      left: 0;
      opacity: 0;
      position: fixed;
      right: 0;
      top: 0;
      transition: 0.3s;
      visibility: hidden;
      z-index: 9;

      &.is-active {
        opacity: 1;
        visibility: visible;

        .cart-drawer-modal {
          opacity: 1;
          transform: translate(0);
          visibility: visible;
        }
      }
    }

    .cart-drawer-modal {
      background: #eee;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 2rem);
      max-width: 320px;
      opacity: 0;
      position: fixed;
      right: 16px;
      top: 1rem;
      transform: translate(100%);
      transition: 0.3s;
      visibility: hidden;
      width: 90vw;

      @media (min-width: 768px) {
        max-width: 440px;
      }
    }

    .cart-modal__header {
      align-items: center;
      border-bottom: 1px solid #ddd;
      display: flex;
      justify-content: space-between;
      padding: 16px;
      .cart-modal__header-title {
        align-self: center;
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
      }
      .cart-modal__header-right {
        #cart-modal__close-btn {
          align-items: center;
          cursor: pointer;
          display: flex;
          height: 32px;
          justify-content: center;
          width: 32px;
        }
      }
    }
    .cart-modal__body {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      .cart-item {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        display: grid;
        grid-template-columns: 100px 1fr auto;
        margin-bottom: 12px;
        min-height: 130px;
        overflow: hidden;
        transition: opacity 0.2s;

        &.is-loading {
          opacity: 0.5;
          pointer-events: none;
        }
      }
      .cart-item__media {
        background: #f5f5f5;
        display: block;

        img {
          display: block;
          height: 100%;
          object-fit: cover;
          width: 100%;
        }
      }
      .cart-item__details {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        padding: 16px 8px 16px 16px;
      }
      .cart-item__title {
        color: #000;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.3;
        text-decoration: none;
        text-transform: uppercase;
      }
      .cart-item__variant {
        color: #777;
        font-size: 12px;
        margin: 0;
        text-transform: uppercase;
      }
      .cart-item__qty {
        align-self: flex-start;
        border: 1px solid #ddd;
        border-radius: 4px;
        display: inline-flex;
        margin-top: auto;

        button {
          align-items: center;
          background: none;
          border: 0;
          cursor: pointer;
          display: flex;
          font-size: 18px;
          height: 32px;
          justify-content: center;
          width: 38px;
        }

        input {
          -moz-appearance: textfield;
          appearance: textfield;
          border: 0;
          border-left: 1px solid #ddd;
          border-right: 1px solid #ddd;
          font-size: 15px;
          height: 32px;
          text-align: center;
          width: 40px;

          &::-webkit-inner-spin-button,
          &::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
          }
        }
      }
      .cart-item__aside {
        align-items: flex-end;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 16px;
      }
      .cart-item__price {
        font-size: 15px;
        white-space: nowrap;
      }
      .cart-item__remove {
        background: none;
        border: 0;
        color: #d32f2f;
        cursor: pointer;
        display: flex;
        padding: 4px;
      }
    }
    .cart-modal__footer {
      border-top: 1px solid #ddd;
      padding: 24px 16px 16px;
      .clear-cart-btn-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 32px;
        .clear-cart-btn {
          background: none;
          border: 0;
          color: #000;
          cursor: pointer;
          font-size: 14px;
          letter-spacing: 0.5px;
          padding: 0;
          text-decoration: underline;
          text-transform: uppercase;

          &:disabled {
            cursor: wait;
            opacity: 0.5;
          }
        }
      }
      .subtotal-wrapper {
        margin-bottom: 16px;
        text-align: right;
        .subtotal-txt {
          font-size: 14px;
          margin: 0;
        }
        .subtotal-price {
          font-size: 20px;
          font-weight: 700;
        }
      }
      .view-cart-btn,
      .checkout-btn {
        align-items: center;
        border: 1px solid #000;
        display: flex;
        font-size: 14px;
        font-weight: 700;
        height: 50px;
        justify-content: center;
        letter-spacing: 1px;
        text-decoration: none;
        text-transform: uppercase;
        transition: opacity 0.2s;
        width: 100%;

        &:hover {
          opacity: 0.85;
        }
      }
      .view-cart-btn {
        background: #fff;
        color: #000;
        margin-bottom: 12px;
        &:hover {
          background: #000;
        color: #fff;
        }
      }
      .checkout-btn {
        background: #000;
        color: #fff;
      }
    }
  }
{% endstylesheet %}

<script>
  document.querySelector('#shopping-cart-button').addEventListener('click', () => {
    document.querySelector('cart-drawer .cart-drawer-wrapper').classList.toggle('is-active');
  });

  document.querySelector('#cart-modal__close-btn').addEventListener('click', () => {
    document.querySelector('cart-drawer .cart-drawer-wrapper').classList.remove('is-active');
  });

  const cartDrawer = document.querySelector('cart-drawer');
  const cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  // Swap in fresh body + footer HTML (header is left alone so the close button listener survives)
  cartDrawer.renderContents = (response) => {
    const applyHtml = (html) => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      ['.cart-modal__body', '.cart-modal__footer'].forEach((selector) => {
        const fresh = doc.querySelector(selector);
        const current = cartDrawer.querySelector(selector);
        if (fresh && current) current.innerHTML = fresh.innerHTML;
      });

      // Keep the header cart bubble in sync with the freshly rendered cart
      const freshFooter = doc.querySelector('.cart-modal__footer');
      if (freshFooter) {
        const count = Number(freshFooter.dataset.itemCount) || 0;
        document.querySelectorAll('[data-cart-count]').forEach((bubble) => {
          bubble.textContent = count;
          bubble.hidden = count === 0;
        });
      }
      cartDrawer.querySelector('.cart-drawer-wrapper').classList.add('is-active');
    };

    if (response && response.sections && response.sections['cart-drawer']) {
      applyHtml(response.sections['cart-drawer']);
    } else {
      fetch(`${window.location.pathname}?sections=cart-drawer`)
        .then((res) => res.json())
        .then((sections) => applyHtml(sections['cart-drawer']));
    }
  };

  const updateLine = (item, quantity) => {
    item.classList.add('is-loading');

    fetch(`${cartRoot}cart/change.js`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        line: Number(item.dataset.line),
        quantity: Math.max(0, quantity),
        sections: 'cart-drawer',
        sections_url: window.location.pathname
      })
    })
      .then((res) => res.json())
      .then((response) => cartDrawer.renderContents(response))
      .catch(() => item.classList.remove('is-loading'));
  };

  const clearCart = (button) => {
    button.disabled = true;

    fetch(`${cartRoot}cart/clear.js`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        sections: 'cart-drawer',
        sections_url: window.location.pathname
      })
    })
      .then((res) => res.json())
      .then((response) => cartDrawer.renderContents(response))
      .catch(() => (button.disabled = false));
  };

  cartDrawer.addEventListener('click', (event) => {
    const clearButton = event.target.closest('.clear-cart-btn');
    if (clearButton) return clearCart(clearButton);

    const item = event.target.closest('.cart-item');
    if (!item) return;

    const input = item.querySelector('[data-qty-input]');
    const quantity = Number(input.value) || 0;

    if (event.target.closest('[data-qty-minus]')) updateLine(item, quantity - 1);
    if (event.target.closest('[data-qty-plus]')) updateLine(item, quantity + 1);
    if (event.target.closest('[data-remove]')) updateLine(item, 0);
  });

  cartDrawer.addEventListener('change', (event) => {
    if (!event.target.matches('[data-qty-input]')) return;
    updateLine(event.target.closest('.cart-item'), Number(event.target.value) || 0);
  });
  
</script>
