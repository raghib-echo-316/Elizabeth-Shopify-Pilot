<div class="w-full py-6 px-3">
  <div class="border bg-white shadow-lg rounded-lg overflow-hidden">
    {% comment %} start {% endcomment %}
    <a href="{{ product_product.url }}">
      {% if product_product.featured_image %}
        <div class="h-40 overflow-hidden">
          <img
            class="w-full h-full object-cover transition duration-1000 ease-in-out  transform hover:scale-105"
            src="{{ product_product.featured_image | image_url: width: 500 }}"
            alt="{{ product_product.featured_image.alt }}"
            width="500"
            height="500"
          >
        </div>
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-100' }}
      {% endif %}
    </a>
    {% comment %} end {% endcomment %}
    {% comment %} {{ 'product-1' | placeholder_svg_tag: 'w-full h-80 object-cover bg-gray-100' }} {% endcomment %}

    <div class="flex flex-col p-4">
      <span class="text-sm text-gray-400">Vendor</span>
      <span class="uppercase text-lg font-medium text-gray-700 y-2">Placeholder title</span>
      <span class="text-base text-gray-500">{{ '9999' | money }}</span>
    </div>
  </div>
</div>
