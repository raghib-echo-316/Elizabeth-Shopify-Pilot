{%- comment -%}
  Line icons used on the trade page.
  Usage: {% render 'trade-icon', icon: 'truck' %}
{%- endcomment -%}
<svg class="trade-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'box' -%}
      <path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/>
    {%- when 'truck' -%}
      <path d="M2 6h12v10H2zM14 9h4l3 3v4h-7"/><circle cx="6" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'tag' -%}
      <path d="M3 12V4h8l10 10-7 7-8-9Z"/><circle cx="7.5" cy="7.5" r="1.5"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
    {%- when 'star' -%}
      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2-5.5-2.9-5.5 2.9 1-6.2L3 9.6l6.2-.9L12 3Z"/>
    {%- when 'percent' -%}
      <path d="M19 5 5 19"/><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5 9-10"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- else -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
  {%- endcase -%}
</svg>
